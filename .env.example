# Credentials go here, NOT in .env.example.
#
# Copy this file to `.env.local` in the repo root and fill in the real values.
# `.env.local` is gitignored and Vite loads it in every mode.
#
# Do not use .env.development.local — that is only read in `development` mode
# and is silently ignored by `npm run dev:live`.
#
# The anon public key is publishable by design: it is already embedded in the
# deployed client bundle, so there is nothing to protect. The service_role key
# must NEVER be placed here — nothing in this project talks to a server.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Groq, for the AI assistant. Get one at https://console.groq.com/keys
#
# Unlike the Supabase key above, this is NOT safe in a public bundle: VITE_*
# values are inlined into the deployed JavaScript, so anyone who loads the site
# can read it and spend against the quota. It has to live here because the
# browser calls Groq directly and the project has no server.
VITE_GROQ_API_KEY=your-groq-key

# Optional. Defaults to openai/gpt-oss-120b.
# Verify with:  node scripts/check-ai.cjs
VITE_GROQ_MODEL=openai/gpt-oss-120b