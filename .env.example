# Credentials go here, NOT in .env.example.
#
# Copy this file to `.env.local` in the repo root and fill in the real values.
# `.env.local` is gitignored and Vite loads it in every mode.
#
# Do not use .env.development.local — that is only read in `development` mode
# and is silently ignored by `npm run dev:live`.
#
# The anon public key is publishable by design: it is already embedded in the
# deployed client bundle, so there is nothing to protect. The service_role key
# must NEVER be placed here — nothing in this project talks to a server.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Auth0, for the "Continue with Auth0" sign-in.
#
# Both values are PUBLIC: they are shipped in the browser bundle of every SPA
# that uses Auth0, and the client secret of a SPA application does not exist.
# Nothing here grants access on its own — the verified email must be linked to a
# row in site_users, and the role is read from that row.
#
# The Auth0 application must list every origin you run on as an Allowed Callback
# URL, Allowed Logout URL and Allowed Web Origin, including
# http://localhost:5173 for local development. A missing entry shows up as a
# callback mismatch after login.
VITE_AUTH0_DOMAIN=dev-khv0g5lmbvhwr174.us.auth0.com
VITE_AUTH0_CLIENT_ID=BRxAT0jrLX8ySZACCOEWptWhr8f7U15I

# Optional. The app otherwise sends <current origin>/ (with the trailing slash,
# because Auth0 compares the string exactly). Only set this if the Auth0
# application expects a different callback.
# VITE_AUTH0_REDIRECT_URI=http://localhost:5173/

# Optional. Auth0's identifier for the Google social connection. Only change it
# if the connection was renamed in the tenant.
# VITE_AUTH0_GOOGLE_CONNECTION=google-oauth2

# Groq, for the AI assistant. Get one at https://console.groq.com/keys
#
# NO VITE_ PREFIX, deliberately. Vite inlines VITE_-prefixed variables into the
# deployed JavaScript, so a key with that prefix is readable by anyone who loads
# the site — labelling it Secret in the dashboard does not change that; the
# prefix decides it.
#
# Without the prefix it stays server-side. api/assistant.js reads it and proxies
# the call, so the browser never sees the key.
#
# In production these go in Vercel as GROQ_API_KEY (Secret) and GROQ_MODEL.
GROQ_API_KEY=your-groq-key

# Optional. Defaults to openai/gpt-oss-120b.
# Verify with:  node scripts/check-ai.cjs
GROQ_MODEL=openai/gpt-oss-120b