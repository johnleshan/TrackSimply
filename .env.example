# Credentials go here, NOT in .env.example.
#
# Copy this file to `.env.local` in the repo root and fill in the real values.
# `.env.local` is gitignored and Vite loads it in every mode.
#
# Do not use .env.development.local — that is only read in `development` mode
# and is silently ignored by `npm run dev:live`.
#
# The anon public key is publishable by design: it is already embedded in the
# deployed client bundle, so there is nothing to protect. The service_role key
# must NEVER be placed here — nothing in this project talks to a server.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key