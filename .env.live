# Read-only session against the real database — `npm run dev:live`
#
# Committed deliberately: nothing here is secret. VITE_TRACKSIMPLY_READONLY=1
# activates the dev-only write guard (scripts/dev-write-guard.js), which refuses
# every create, update and delete so a local session cannot alter client
# records. Reads pass through untouched.
#
# Credentials go in .env.local, not here. Vite loads .env.local in every mode,
# and .env.local is gitignored. Note that .env.live takes precedence over it, so
# it must not define VITE_SUPABASE_URL or the guard mode would be pointless.
VITE_TRACKSIMPLY_READONLY=1